# Copy this file to .env and fill in your real keys.
# Vite only exposes variables prefixed with VITE_ to client-side code.

# FortyGuard Temperature API (https://www.fortyguard.com/hackathon26)
VITE_FORTYGUARD_API_KEY=

# Google AI Studio Gemini API key (https://aistudio.google.com)
VITE_GEMINI_API_KEY=
